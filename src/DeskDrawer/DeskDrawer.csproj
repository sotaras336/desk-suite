<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>   <!-- no Windows SDK version: that pulled in a 25 MB WinRT library nothing here uses -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DeskDrawer</AssemblyName>
    <RootNamespace>DeskDrawer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <StartupObject>DeskDrawer.Program</StartupObject>
    <ApplicationIcon>DeskDrawer.ico</ApplicationIcon>
    <!-- small and quick: precompiled startup code, no background-GC thread and its extra heap, memory handed back sooner -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>   <!-- PGO instruments fresh code: slower to start -->
  </PropertyGroup>

</Project>
