<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>   <!-- no Windows SDK version: that pulled in a 25 MB WinRT library nothing here uses -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>   <!-- reads DeskBar's memory-mapped file index -->
    <AssemblyName>DeskDrawer</AssemblyName>
    <RootNamespace>DeskDrawer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <StartupObject>DeskDrawer.Program</StartupObject>
    <ApplicationIcon>DeskDrawer.ico</ApplicationIcon>
    <!-- small and quick: precompiled startup code, no background-GC thread and its extra heap, memory handed back sooner -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>   <!-- PGO instruments fresh code: slower to start -->
  </PropertyGroup>

  <!-- when this build was made (UTC), for the update check: a release only counts as newer when it was built later. CI passes -p:DeskBuilt=... so the
       release list and the exe agree to the second; a local build stamps its own time. -->
  <PropertyGroup>
    <DeskBuilt Condition="'$(DeskBuilt)' == ''">$([System.DateTime]::UtcNow.ToString("yyyyMMddTHHmmssZ"))</DeskBuilt>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="DeskBuilt" Value="$(DeskBuilt)" />
  </ItemGroup>

</Project>
