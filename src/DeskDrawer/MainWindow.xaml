<Window x:Class="DeskDrawer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeskDrawer"
        Title="DeskDrawer" Width="1320" Height="760" MinWidth="640" MinHeight="400"
        Background="{DynamicResource WinBg}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- No Windows title bar: the tab strip is the title bar (drag it, double-click it), with our own minimise / maximise / close -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Shared by the list, tiles and icon views: hidden items dimmed, and the name swaps for a text box while renaming (F2) -->
        <Style x:Key="Dim" TargetType="FrameworkElement">
            <Style.Triggers><DataTrigger Binding="{Binding IsHidden}" Value="True"><Setter Property="Opacity" Value="0.55"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ShowUnlessRenaming" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsRenaming}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="EditWhileRenaming" TargetType="TextBox" BasedOn="{StaticResource RenameBox}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsRenaming}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>

        <DataTemplate x:Key="ListTpl">
            <StackPanel Orientation="Horizontal" Width="250" Style="{StaticResource Dim}">
                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="2,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Grid Width="216">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Style="{StaticResource ShowUnlessRenaming}"/>
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditWhileRenaming}"
                             IsVisibleChanged="RenameBox_Visible" KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_Lost"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TileTpl">
            <Grid Width="290" Height="60" Style="{StaticResource Dim}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Image Source="{Binding Big}" Width="48" Height="48" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,4,0">
                    <Grid>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Style="{StaticResource ShowUnlessRenaming}"/>
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditWhileRenaming}"
                                 IsVisibleChanged="RenameBox_Visible" KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_Lost"/>
                    </Grid>
                    <TextBlock Text="{Binding TypeText}" Foreground="{DynamicResource FgDim}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource FgFaint}" FontSize="12"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="IconTpl">
            <StackPanel Width="{DynamicResource IconCellW}" Margin="0,4,0,2" Style="{StaticResource Dim}">
                <Image Source="{Binding Big}" Width="{DynamicResource IconPx}" Height="{DynamicResource IconPx}" Stretch="Uniform" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Grid Margin="0,6,0,0">
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" MaxHeight="38" Style="{StaticResource ShowUnlessRenaming}"/>
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource EditWhileRenaming}"
                             IsVisibleChanged="RenameBox_Visible" KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_Lost"/>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapH"><WrapPanel Orientation="Horizontal" Margin="6,6,0,0"/></ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="WrapV"><WrapPanel Orientation="Vertical" Margin="6,6,0,0"/></ItemsPanelTemplate>
        <sys:Double x:Key="IconPx" xmlns:sys="clr-namespace:System;assembly=mscorlib">96</sys:Double>
        <sys:Double x:Key="IconCellW" xmlns:sys="clr-namespace:System;assembly=mscorlib">124</sys:Double>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Tab strip -->
        <Border Background="{DynamicResource StripBg}" Padding="8,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,-6,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Caption}" Content="&#xE921;" ToolTip="Minimise" Click="Min_Click"/>
                    <Button x:Name="MaxBtn" Style="{StaticResource Caption}" Content="&#xE922;" ToolTip="Maximise" Click="Max_Click"/>
                    <Button Style="{StaticResource CaptionClose}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click"/>
                </StackPanel>
                <ItemsControl x:Name="TabStrip" Focusable="False" VerticalAlignment="Bottom" WindowChrome.IsHitTestVisibleInChrome="True">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="T" Height="36" MinWidth="210" MaxWidth="280" Margin="0,0,2,0" CornerRadius="8,8,0,0" Background="Transparent"
                                    MouseLeftButtonDown="Tab_Down" MouseDown="Tab_MiddleDown" MouseRightButtonUp="Tab_RightUp" MouseMove="Tab_Move" ToolTip="{Binding Current}"
                                    AllowDrop="True" DragEnter="Tab_DragEnter" DragOver="Tab_DragOver" Drop="Tab_Drop">
                                <Grid Margin="12,0,4,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid Width="16" Height="16" Margin="0,0,9,0" VerticalAlignment="Center">
                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="#FFC83D" VerticalAlignment="Center">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Style="{StaticResource Tool}" Width="24" Height="24" FontSize="9" Content="&#xE711;" Margin="6,0,0,0" ToolTip="Close tab (Ctrl+W)" Click="TabClose_Click"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="T" Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="{DynamicResource Card}"/></Trigger>
                                <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter TargetName="T" Property="Background" Value="{DynamicResource BarBg}"/></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Grid.Column="1" Style="{StaticResource Tool}" Width="30" Height="30" Content="&#xE710;" HorizontalAlignment="Left" Margin="4,0,0,3" ToolTip="New tab (Ctrl+T)" Click="NewTab_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource BarBg}" BorderBrush="{DynamicResource BarLine}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackBtn" Style="{StaticResource Tool}" Content="&#xE72B;" ToolTip="Back (Alt+Left)" Click="Back_Click"/>
                    <Button x:Name="ForwardBtn" Style="{StaticResource Tool}" Content="&#xE72A;" ToolTip="Forward (Alt+Right)" Click="Forward_Click"/>
                    <Button x:Name="UpBtn" Style="{StaticResource Tool}" Content="&#xE74A;" ToolTip="Up (Alt+Up)" Click="Up_Click"/>
                    <Button Style="{StaticResource Tool}" Content="&#xE72C;" ToolTip="Refresh (F5)" Click="Refresh_Click"/>
                </StackPanel>
                <Grid Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                    <TextBox x:Name="Address" Style="{StaticResource Field}" Visibility="Hidden"
                             ToolTip="Type a folder path and press Enter" KeyDown="Address_KeyDown" GotKeyboardFocus="Address_GotFocus" LostKeyboardFocus="Address_Lost"/>
                    <Border x:Name="CrumbBar" Height="34" CornerRadius="17" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardLine}" BorderThickness="1"
                            MouseLeftButtonDown="CrumbBar_Down" ToolTip="Click an empty spot to type a path (Ctrl+L)">
                        <ScrollViewer x:Name="CrumbScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="10,0" Background="Transparent">
                            <StackPanel x:Name="Crumbs" Orientation="Horizontal" VerticalAlignment="Center"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <TextBox x:Name="Search" Style="{StaticResource Field}" TextChanged="Search_Changed" KeyDown="Search_KeyDown" Padding="34,0,12,0" ToolTip="Type to filter this folder. Enter searches every folder inside it too (several words: all of them must match). From Home or This PC, Enter searches the whole PC"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource FgDim}" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchHint" Text="Filter · Enter searches inside" Foreground="{DynamicResource FgFaint}" Margin="34,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Command bar (New, Cut, Copy, Paste, Rename, Share, Delete | Sort, View, Filter, more), filled in code -->
        <Border Grid.Row="2" Background="{DynamicResource BarBg}" BorderBrush="{DynamicResource BarLine}" BorderThickness="0,0,0,1">
            <StackPanel x:Name="CmdBar" Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center"/>
        </Border>

        <!-- Folder tree | file list -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="140"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
                <ColumnDefinition x:Name="PreviewSplitCol" Width="6"/>
                <ColumnDefinition x:Name="PreviewCol" Width="340" MinWidth="0"/>
            </Grid.ColumnDefinitions>

            <GridSplitter x:Name="PreviewSplit" Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ShowsPreview="False"/>
            <local:PreviewPane x:Name="Preview" Grid.Column="4"/>

            <Border Background="{DynamicResource PaneBg}">
                <TreeView x:Name="Tree" Background="Transparent" BorderThickness="0" Padding="6,8" SelectedItemChanged="Tree_Selected" AllowDrop="True"
                          DragOver="Tree_DragOver" Drop="Tree_Drop" PreviewMouseDown="Tree_MouseDown" MouseRightButtonUp="Tree_RightUp"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ShowsPreview="False"/>

            <Grid Grid.Column="2" Background="Transparent" MouseRightButtonUp="Background_RightClick">
                <ListView x:Name="List" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Fg}" SelectionMode="Extended" AllowDrop="True"
                          SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_DoubleClick" KeyDown="List_KeyDown"
                          PreviewMouseLeftButtonDown="List_PreviewDown" PreviewMouseMove="List_PreviewMove" PreviewMouseDown="List_MiddleDown"
                          PreviewMouseRightButtonDown="List_RightDown" PreviewMouseRightButtonUp="List_RightUp"
                          DragOver="List_DragOver" Drop="List_Drop"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel" LostMouseCapture="List_LostCapture" IsTextSearchEnabled="True" TextSearch.TextPath="Name">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,14,12,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ItemCount, StringFormat='  {0}'}" FontSize="13" Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Height="1" Margin="12,1,0,0" Background="{DynamicResource CardLine}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.View>
                        <GridView AllowsColumnReorder="False">
                            <GridViewColumn Header="Name" Width="270">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsHidden}" Value="True"><Setter Property="Opacity" Value="0.55"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="6,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <Grid>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsRenaming}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>
                                                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" MinWidth="240"
                                                         IsVisibleChanged="RenameBox_Visible" KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_Lost">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource RenameBox}"><Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding IsRenaming}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Date modified" Width="150">
                                <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource FgDim}" Margin="6,0,0,0"/></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Type" Width="130">
                                <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding TypeText}" Foreground="{DynamicResource FgDim}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Size" Width="90">
                                <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource FgDim}" Margin="6,0,0,0"/></DataTemplate></GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <ScrollViewer x:Name="HomePane" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel x:Name="HomeContent" Margin="30,22,22,26"/>
                </ScrollViewer>
                <TextBlock x:Name="Message" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource FgDim}" FontSize="14" Visibility="Collapsed" IsHitTestVisible="False"/>
                <!-- the drag-select box is drawn here, above the list -->
                <Canvas x:Name="MarqueeLayer" IsHitTestVisible="False" ClipToBounds="True"/>
                <!-- Search results: what is being searched, how far it has got, and the way out to a wider search -->
                <Border x:Name="SearchBar" VerticalAlignment="Top" Height="52" Visibility="Collapsed" Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardLine}" BorderThickness="0,0,0,1">
                    <Grid Margin="16,0,8,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SearchTitle" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="SearchDetail" FontSize="12" Foreground="{DynamicResource FgDim}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SearchLiveBtn" Style="{StaticResource Cmd}" Content="Search live" Click="SearchLive_Click" ToolTip="Walk every disk instead of reading DeskBar's list of files: slower, but also finds files made since its last scan"/>
                            <Button x:Name="SearchScopeBtn" Style="{StaticResource Cmd}" Content="Search this PC" Click="SearchScope_Click" ToolTip="Look everywhere on this PC, not only in the folder you started from"/>
                            <Button x:Name="SearchStopBtn" Style="{StaticResource Cmd}" Content="Stop" Click="SearchStop_Click" ToolTip="Stop looking and keep what has been found"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="{DynamicResource PaneBg}" BorderBrush="{DynamicResource BarLine}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock x:Name="Status" Foreground="{DynamicResource FgDim}" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="SelectionStatus" Foreground="{DynamicResource FgDim}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
