<Window x:Class="DeskDrawer.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskDrawer" Width="820" Height="540" MinWidth="560" MinHeight="380" Topmost="True" WindowStartupLocation="Manual" Left="-32000" Top="-32000"
        Background="{DynamicResource WinBg}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- Same look as the DeskDrawer window: no Windows title bar, the coloured strip is the title bar -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- The main action (Open / Save): an accent pill, text set in the template so the app-wide TextBlock colour doesn't turn it white on pale blue -->
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="17" Padding="28,0" Background="{DynamicResource Accent}">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource StripBg}">
            <Grid>
                <TextBlock x:Name="TitleText" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Fg}"/>
                <Button Style="{StaticResource CaptionClose}" Content="&#xE8BB;" Height="42" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Cancel (Esc)" Click="Cancel_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource BarBg}" BorderBrush="{DynamicResource BarLine}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0,12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Tool}" Content="&#xE74A;" ToolTip="Up (Alt+Up)" Click="Up_Click"/>
                    <Button Style="{StaticResource Tool}" Content="&#xE72C;" ToolTip="Refresh" Click="Refresh_Click"/>
                </StackPanel>
                <TextBox x:Name="PathBox" Grid.Column="1" Style="{StaticResource Field}" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Type a folder path and press Enter" KeyDown="Path_KeyDown"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource PaneBg}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel x:Name="Places" Margin="6,8"/>
                </ScrollViewer>
            </Border>
            <ListView x:Name="List" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Fg}" SelectionMode="Extended"
                      SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_DoubleClick" KeyDown="List_KeyDown"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" IsTextSearchEnabled="True" TextSearch.TextPath="Name">
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Header="Name" Width="270">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsHidden}" Value="True"><Setter Property="Opacity" Value="0.55"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="6,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Date modified" Width="140">
                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource FgDim}" Margin="6,0,0,0"/></DataTemplate></GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Size" Width="80">
                            <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource FgDim}" Margin="6,0,0,0"/></DataTemplate></GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock x:Name="Message" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource FgDim}" FontSize="14" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource BarBg}" BorderBrush="{DynamicResource BarLine}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="File name" Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource Field}" VerticalAlignment="Center" KeyDown="Name_KeyDown"/>
                <Button x:Name="FilterBtn" Grid.Column="2" Style="{StaticResource Cmd}" Margin="10,0,0,0" Click="Filter_Click"/>
                <Button x:Name="OkBtn" Grid.Column="3" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="Ok_Click"/>
                <Button Grid.Column="4" Style="{StaticResource Cmd}" Content="Cancel" Margin="4,0,0,0" Click="Cancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
