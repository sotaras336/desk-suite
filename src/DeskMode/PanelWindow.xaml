<Window x:Class="DeskMode.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskMode" Width="384" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Stylus.IsPressAndHoldEnabled="False" Stylus.IsFlicksEnabled="False" Stylus.IsTapFeedbackEnabled="False" Stylus.IsTouchFeedbackEnabled="False">

    <Border x:Name="Root" Margin="12" CornerRadius="12" Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="0"/>
        </Border.RenderTransform>

        <Grid>
        <!-- two slow, drifting glows behind everything (stopped while the panel is hidden) -->
        <Ellipse Width="380" Height="380" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-150,-170,0,0" Opacity="0.34" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush><GradientStop Color="{DynamicResource GlowColor}" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform><TranslateTransform x:Name="GlowA"/></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="340" Height="340" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-140,-120" Opacity="0.22" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush><GradientStop Color="{DynamicResource AccentColor2}" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform><TranslateTransform x:Name="GlowB"/></Ellipse.RenderTransform>
        </Ellipse>
        <StackPanel x:Name="MainPage" Margin="16,14,16,16">

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,2,0,0">
                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="17"
                               Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DeskMode" FontSize="15" FontWeight="SemiBold"/>
                    <WrapPanel Margin="0,5,0,0"><Border CornerRadius="9" Background="{DynamicResource Control}" Padding="8,2,9,2" Margin="0,0,6,0"><StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="MonitorDot" Width="7" Height="7" Margin="0,1,6,0" Fill="{DynamicResource FgDim}"/>
                        <TextBlock x:Name="MonitorStatus" Text="Looking for screens…" FontSize="12" Foreground="{DynamicResource FgDim}"/>
                        </StackPanel></Border><Border CornerRadius="9" Background="{DynamicResource Control}" Padding="8,2,9,2" Margin="0,0,6,0"><StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PowerIcon" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,2,4,0" Foreground="{DynamicResource FgDim}"/>
                        <TextBlock x:Name="PowerStatus" FontSize="12" Foreground="{DynamicResource FgDim}"/>
                    </StackPanel></Border></WrapPanel>
                </StackPanel>
                <Button x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="Settings" VerticalAlignment="Top">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16"/>
                </Button>
            </Grid>

            <!-- A newer build is out (Updater.cs) -->
            <Button x:Name="UpdateBanner" Style="{StaticResource Preset}" Visibility="Collapsed" Click="Update_Click" Margin="0,12,0,0" ToolTip="Downloads the new version from GitHub, checks it and installs it. DeskMode restarts by itself.">
                <TextBlock x:Name="UpdateText" Text="A new version is available · Update now" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}"/>
            </Button>

            <!-- What each screen is doing right now: two glowing mini displays -->
            <Grid x:Name="Hero" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="HeroLaptop">
                    <Border Height="96" CornerRadius="14" Background="{DynamicResource ChipGradient}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource GlowColor}" BlurRadius="24" ShadowDepth="0" Opacity="0.34"/>
                        </Border.Effect>
                        <Grid>
                            <Rectangle RadiusX="12" RadiusY="12" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1">
                                        <GradientStop Color="#40FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="HeroLaptopHz" FontFamily="Segoe UI Variable Display, Segoe UI Light" FontSize="46" FontWeight="Light"/>
                                    <TextBlock Text="Hz" FontSize="14" Foreground="{DynamicResource FgDim}" VerticalAlignment="Bottom" Margin="4,0,0,10"/>
                                </StackPanel>
                                <TextBlock x:Name="HeroLaptopTag" FontSize="10.5" HorizontalAlignment="Center" Foreground="{DynamicResource FgDim}" Margin="0,-6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Width="46" Height="5" CornerRadius="0,0,5,5" Background="{DynamicResource Control}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="HeroLaptopName" Text="Built-in" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgDim}" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel x:Name="HeroMonitor" Grid.Column="2">
                    <Border Height="96" CornerRadius="14" Background="{DynamicResource ChipGradient}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource GlowColor}" BlurRadius="24" ShadowDepth="0" Opacity="0.34"/>
                        </Border.Effect>
                        <Grid>
                            <Rectangle RadiusX="12" RadiusY="12" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1">
                                        <GradientStop Color="#40FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="HeroMonitorHz" FontFamily="Segoe UI Variable Display, Segoe UI Light" FontSize="46" FontWeight="Light"/>
                                    <TextBlock Text="Hz" FontSize="14" Foreground="{DynamicResource FgDim}" VerticalAlignment="Bottom" Margin="4,0,0,10"/>
                                </StackPanel>
                                <TextBlock x:Name="HeroMonitorTag" FontSize="10.5" HorizontalAlignment="Center" Foreground="{DynamicResource FgDim}" Margin="0,-6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Width="46" Height="5" CornerRadius="0,0,5,5" Background="{DynamicResource Control}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="HeroMonitorName" Text="Monitor" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgDim}" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Presets -->
            <TextBlock Text="Apply a preset" Style="{StaticResource SectionTitle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition x:Name="GapA" Width="6"/>
                    <ColumnDefinition x:Name="ColB"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button x:Name="MaxButton" Style="{StaticResource Preset}" Click="Max_Click"
                        ToolTip="Your Go max settings: power mode, Energy saver and each screen's refresh rate (change them in Settings)">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left"><TextBlock Text="&#xEC4A;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="Go max" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock x:Name="MaxSub" Text="Highest rates" FontSize="11.5" Foreground="{DynamicResource FgDim}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="MaxLgButton" Grid.Column="2" Style="{StaticResource Preset}" Click="MaxLg_Click"
                        ToolTip="Same as Go max, but the built-in screen stays at the easy rate so less GPU work goes to it">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left"><TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock x:Name="FirstTitle" Text="Monitor first" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock x:Name="FirstSub" Text="Built-in easy" FontSize="11.5" Foreground="{DynamicResource FgDim}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SaverButton" Grid.Column="4" Style="{StaticResource Preset}" Click="Saver_Click"
                        ToolTip="Your Go easy settings: power mode, Energy saver and one gentle refresh rate on every screen (change them in Settings)">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Left"><TextBlock Text="&#xEBB4;" FontFamily="{StaticResource IconFont}" FontSize="17" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="Go easy" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        <TextBlock x:Name="EasySub" Text="60Hz · saver" FontSize="11.5" Foreground="{DynamicResource FgDim}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Power -->
            <TextBlock x:Name="PowerTitle" Text="Power mode right now" Style="{StaticResource SectionTitle}"/>
            <Border x:Name="PowerCard" Style="{StaticResource Card}">
                <StackPanel>
                    <Border Style="{StaticResource SegmentHost}">
                        <UniformGrid Rows="1" x:Name="ModeGrid"/>
                    </Border>
                    <TextBlock x:Name="ModeSource" FontSize="11.5" Foreground="{DynamicResource FgDim}" Margin="4,6,0,0"/>
                    <CheckBox x:Name="EnergySaverSwitch" Style="{StaticResource Switch}" Margin="2,12,0,0" Click="EnergySaver_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE863;" FontFamily="{StaticResource IconFont}" Margin="0,2,10,0"/>
                            <TextBlock Text="Energy saver"/>
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Screens: one card each, with its refresh rate and brightness -->
            <TextBlock x:Name="ScreensTitle" Text="Screens" Style="{StaticResource SectionTitle}"/>
            <Border x:Name="LaptopCard" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="LaptopRatesLabel" Text="Built-in" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock x:Name="LaptopHzNow" HorizontalAlignment="Right" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                    </Grid>
                    <Border x:Name="LaptopRatesHost" Style="{StaticResource SegmentHost}" Margin="0,10,0,0">
                        <UniformGrid x:Name="LaptopRates" Rows="1"/>
                    </Border>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LaptopLabel" Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource FgDim}"/>
                        <Slider x:Name="LaptopSlider" Grid.Column="1" Style="{StaticResource Brightness}" ValueChanged="Laptop_Changed"/>
                        <TextBlock x:Name="LaptopValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource FgDim}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border x:Name="MonitorCard" Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="MonitorRatesLabel" Text="Monitor" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock x:Name="MonitorHzNow" HorizontalAlignment="Right" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                    </Grid>
                    <Border Style="{StaticResource SegmentHost}" Margin="0,10,0,0">
                        <UniformGrid x:Name="MonitorRates" Rows="1"/>
                    </Border>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MonitorLabel" Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource FgDim}"/>
                        <Slider x:Name="MonitorSlider" Grid.Column="1" Style="{StaticResource Brightness}" ValueChanged="Monitor_Changed"/>
                        <TextBlock x:Name="MonitorValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource FgDim}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border x:Name="BothCard" Style="{StaticResource Card}" Margin="0,8,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="64"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="BothLabel" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0"/>
                            <TextBlock Text="Both" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Slider x:Name="BothSlider" Grid.Column="1" Style="{StaticResource Brightness}" ValueChanged="Both_Changed"/>
                        <TextBlock x:Name="BothValue" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>
                    <Border x:Name="BothSeparator" Height="1" Background="{DynamicResource CardBorder}" Margin="0,10"/>
                    <CheckBox x:Name="LinkKeys" Style="{StaticResource Switch}" Click="LinkKeys_Click">
                        <TextBlock x:Name="LinkKeysText" Text="Brightness keys also change the monitor" Foreground="{DynamicResource FgDim}" FontSize="12.5"/>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Gaming -->
            <TextBlock x:Name="GameTitle" Text="Gaming" Style="{StaticResource SectionTitle}"/>
            <Border x:Name="GameCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="GameStatus" FontSize="12" Foreground="{DynamicResource FgDim}" TextWrapping="Wrap"/>
                    <CheckBox x:Name="GameLockSwitch" Style="{StaticResource Switch}" Margin="2,10,0,0" Click="GameLock_Click"
                              ToolTip="While a full-screen game is up, DeskMode does not change refresh rates or power modes by itself">
                        <TextBlock Text="Keep screen modes steady during games" FontSize="12.5"/>
                    </CheckBox>
                    <CheckBox x:Name="AutoBorderlessSwitch" Style="{StaticResource Switch}" Margin="2,8,0,0" Click="AutoBorderless_Click"
                              ToolTip="Windowed games on your list (Settings) become borderless full-screen: no screen mode switch, so no black screens, and alt-tab is instant">
                        <TextBlock Text="Borderless for games on my list, automatically" FontSize="12.5"/>
                    </CheckBox>
                    <Button x:Name="BorderlessNow" Style="{StaticResource Preset}" Margin="0,10,0,0" Click="BorderlessNow_Click"
                            ToolTip="Borderless full-screen on/off for the running game (it has to be in windowed mode first)">
                        <TextBlock Text="Borderless on / off now" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </Button>
                    <TextBlock Text="Ctrl+Alt+F: borderless on/off for the window in front (set the game to windowed first)"
                               FontSize="11" Foreground="{DynamicResource FgDim}" Opacity="0.75" Margin="2,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <StackPanel Margin="2,14,0,0">
                <Button x:Name="MoreSettings" Style="{StaticResource Preset}" Click="Settings_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" Margin="0,2,8,0"/>
                        <TextBlock Text="Settings" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="HotkeyHint" Text="Ctrl+Alt+D panel · M max · B easy · F borderless"
                           FontSize="11" Foreground="{DynamicResource FgDim}" Opacity="0.75" Margin="0,12,0,0"/>
            </StackPanel>
        </StackPanel>
        <Border x:Name="SettingsHost" Margin="16,14,6,12" Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
